# نمونه متغیرهای محیطی — هیچ مقدار واقعی در این فایل قرار ندهید.
# این فایل را به .env کپی کنید و مقادیر را تکمیل کنید.

# --- اجرای برنامه ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# اگر پشت پروکسی/سی‌پنل اجرا می‌شود ۱ بگذارید
TRUST_PROXY=1

# --- کلیدها (الزامی در محیط عملیاتی) ---
# با دستور زیر بسازید:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# توکن یک‌بارمصرف برای ساخت اولین مدیر در مسیر /admin/setup
ADMIN_SETUP_TOKEN=
# پس از ساخت مدیر اولیه می‌توانید ۱ بگذارید تا مسیر نصب کاملاً بسته شود.
SETUP_DISABLED=0

# --- مسیرها ---
# دیتابیس باید بیرون از پوشه عمومی (public) باشد.
DB_PATH=./storage/school.db
UPLOAD_DIR=./public/uploads
BACKUP_DIR=./storage/backups

# --- کوکی نشست ---
# در HTTPS مقدار ۱ بگذارید.
COOKIE_SECURE=1
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=12

# --- محدودیت‌ها ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_MOBILE_HOUR=5
OTP_MAX_PER_IP_HOUR=20
PREREG_MAX_PER_IP_HOUR=5
PREREG_DUPLICATE_WINDOW_HOURS=24
MAX_UPLOAD_MB=3
RATE_LIMIT_API_PER_MINUTE=300

# --- سرویس پیامک (اختیاری) ---
# گزینه‌ها: kavenegar | melipayamak | ippanel | log (فقط توسعه)
# در صورت خالی بودن، تنظیمات از پنل مدیریت (/admin/sms) خوانده می‌شود.
SMS_PROVIDER=
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER=
SMS_OTP_TEMPLATE=کد ورود شما به سایت مدرسه: {code}

# --- لاگ ---
LOG_LEVEL=info
